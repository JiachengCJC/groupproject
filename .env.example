# Everything works offline without API keys in the default local mode.
# Copy this file to .env if it does not exist, then edit the settings you need.
# Apply changes with: docker compose up --build -d --wait
OPENAI_API_KEY=
# Set to a model your API account can access with Responses structured outputs.
OPENAI_MODEL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Database storage is configured in compose.yaml using a persistent Docker volume.
# Host port for Docker Compose. Use 8001 if 8000 is already occupied.
PORT=8000

# Ollama: Docker reaches the host at host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Leave blank to choose any installed model in the UI.
OLLAMA_MODEL=
# Optional, must support images. A text-only model cannot read images.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=180
OLLAMA_CONTEXT=8192
OCR_LANGUAGES=eng+chi_sim+chi_tra
# Optional audio/video: rebuild with INSTALL_MEDIA=1 and set e.g. tiny or base.
INSTALL_MEDIA=0
WHISPER_MODEL=
