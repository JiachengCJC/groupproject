# Run python3 scripts/configure.py to create .env and random deployment secrets.
# Apply changes with: docker compose up --build -d --wait
# Model-free baseline remains available. Cloud models require the values below.
OPENAI_API_KEY=
# Set to a model your API account can access with Responses structured outputs.
OPENAI_MODEL=
# Optional operator-maintained prices; -1 reports unknown cost.
OPENAI_INPUT_USD_PER_MILLION=-1
OPENAI_OUTPUT_USD_PER_MILLION=-1
PRICE_VERSION=
# Uses the same OPENAI_API_KEY for the dedicated Decisions endpoint.
OPENAI_DECISION_MODEL=gpt-6-luna
# Optional separate Decisions price estimate. Output tokens are not charged.
OPENAI_DECISIONS_INPUT_USD_PER_MILLION=-1
OPENAI_DECISIONS_PRICE_VERSION=
# Database storage is configured in compose.yaml using a persistent Docker volume.
# Host port for Docker Compose. Use 8001 if 8000 is already occupied.
PORT=8000

# Ollama: Docker reaches the host at host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Leave blank to choose any installed model in the UI.
OLLAMA_MODEL=
# Named local profiles use these installed models; Custom retains OLLAMA_MODEL.
OLLAMA_FAST_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_QUALITY_MODEL=qwen3.5:9b-q4_K_M
# Optional, must support images. A text-only model cannot read images.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=180
OLLAMA_CONTEXT=8192
# Disable optional thinking to reserve the structured-output budget for answers.
OLLAMA_THINKING=off
OLLAMA_NUM_PREDICT=2400
# Unload after each call on small-memory machines; larger servers may use 1m.
OLLAMA_KEEP_ALIVE=0
OCR_LANGUAGES=eng+chi_sim+chi_tra
# Optional audio/video: rebuild with INSTALL_MEDIA=1 and set e.g. tiny or base.
INSTALL_MEDIA=0
WHISPER_MODEL=

# Team deployment. configure.py generates these; never use example passwords.
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
ANALYTICS_PASSWORD=
SETUP_TOKEN=
# Optional bootstrap admin instead of first-run setup screen (password >=12 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],market-lens
COOKIE_SECURE=false
SEED_DEMO=true
# For HTTPS cloud deployment set SITE_DOMAIN and use compose.cloud.yaml.
SITE_DOMAIN=

# Strict local-only rejects cloud inference/Decisions and online source synchronization.
LOCAL_ONLY=false
# Enable real vector retrieval after installing an embedding model in Ollama.
# RETRIEVAL_MODE=hybrid, EMBEDDING_PROVIDER=ollama, EMBEDDING_MODEL=nomic-embed-text
RETRIEVAL_MODE=lexical
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=
EMBEDDING_REVISION=
ALLOW_EXTERNAL_SOURCES=true
# Comma-separated domains; empty permits public HTTP(S) hosts, never private IPs.
SOURCE_ALLOWED_HOSTS=
MAX_MODEL_CALLS=20
MAX_AGENT_STEPS=3
ANALYSIS_TIMEOUT=300
